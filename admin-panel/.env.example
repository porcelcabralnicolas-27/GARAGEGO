# Copiar a `.env` y completar con los mismos valores del .env de la raíz del repo
# (EXPO_PUBLIC_SUPABASE_URL y EXPO_PUBLIC_SUPABASE_ANON_KEY).
#
# Solo la anon key. NUNCA la service_role key: este bundle se sirve al navegador y cualquiera
# podria leerla desde las devtools.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
