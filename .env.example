EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo para el mapa en la versión web (npx expo start --web).
# Google Cloud Console > APIs & Services > Credentials > crear API key,
# con "Maps JavaScript API" habilitada. La app nativa usa las keys de app.json (iOS/Android), no esta.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=your-google-maps-javascript-api-key
